# Copy to .env.staging (or just run dbclone and answer the prompts; it can save this file
# for you with mode 0600). Leave an engine's settings empty to skip it.

# mongo
STG_MONGO_URI="mongodb://user:password@staging-host:27017/?authSource=admin"

# mysql
STG_MYSQL_HOST="staging-host"
STG_MYSQL_PORT="3306"
STG_MYSQL_USER="reader"
STG_MYSQL_PASSWORD=""
